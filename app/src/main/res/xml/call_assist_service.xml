<?xml version="1.0" encoding="utf-8"?>
<!-- Call mode: the service asks for nothing, it only lets the app keep its microphone during a phone call -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/call_assist_description"
    android:notificationTimeout="1000"
    android:summary="@string/call_assist_summary" />
