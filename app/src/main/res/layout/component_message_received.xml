<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- One message of a conversation: who spoke, what they said, its translation, and a button to hear it.
         The second speaker, in the secondary colour. -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="?attr/colorBackgroundMessageReceived"
        android:visibility="visible"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/speaker_person_icon"
                app:tint="@color/secondary_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_sender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/secondary_dark"
                    android:textSize="12sp"
                    android:visibility="visible"
                    tool:text="Alice" />

                <TextView
                    android:id="@+id/original_text_to_be_translated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="?attr/colorTextLevel1"
                    android:textSize="18sp"
                    android:visibility="visible"
                    tool:text="What was said, in the speaker\'s language" />

                <TextView
                    android:id="@+id/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="?attr/colorTextLevel2"
                    android:textSize="16sp"
                    tool:text="The translation" />
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/tts_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:alpha="1"
                android:backgroundTint="?attr/colorBackgroundMessageReceived"
                android:importantForAccessibility="no"
                android:src="@drawable/sound_icon"
                android:visibility="visible"
                app:borderWidth="0dp"
                app:elevation="0dp"
                app:fabSize="mini"
                app:rippleColor="#12000000"
                app:tint="@color/secondary_dark" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
