<?xml version="1.0" encoding="utf-8"?>
<!-- Offline: what is stored on the phone, and the language packs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackgroundLite"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:paddingStart="4dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"
                android:text="@string/home_nav_offline"
                android:textColor="?attr/colorTextLevel1"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/offline_ready_title"
                    android:textColor="?attr/colorTextLevel1"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/offline_ready_text"
                    android:textColor="?attr/colorTextLevel2"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/offlineStorage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/offline_storage_counting"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="4dp"
                android:paddingTop="22dp"
                android:text="@string/offline_packs_title"
                android:textColor="?attr/colorTextLevel1"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:paddingStart="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="10dp"
                android:text="@string/offline_packs_text"
                android:textColor="?attr/colorTextLevel3"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/offlinePacks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/offlineSettings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/offline_more_settings" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/component_bottom_nav" />
</LinearLayout>
