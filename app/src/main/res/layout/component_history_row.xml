<?xml version="1.0" encoding="utf-8"?>
<!-- One saved conversation in the History and Favorites lists -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_card"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="?attr/colorTextLevel1"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/historyRowPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="?attr/colorTextLevel2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/historyRowDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="?attr/colorTextLevel3"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/historyRowStar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/history_add_favorite"
        android:focusable="false"
        android:src="@drawable/nav_star_icon" />

    <ImageButton
        android:id="@+id/historyRowDelete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/history_delete"
        android:focusable="false"
        android:src="@drawable/delete_icon"
        app:tint="?attr/colorTextLevel3" />
</LinearLayout>
