<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: brand, the two languages of the conversation, and the button that starts it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackgroundLite"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/homeSettingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_activity_settings"
                android:src="@drawable/settings_icon"
                app:tint="?attr/colorTextLevel1" />

            <ImageView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:importantForAccessibility="no"
                android:src="@drawable/app_icon_vector" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/home_brand_first"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/home_brand_second"
                    android:textColor="?attr/colorTextLevel1"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/home_tagline"
                android:textColor="?attr/colorTextLevel1"
                android:textSize="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="18dp">

                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_home_circle">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/home_wave_icon" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|bottom"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_home_card"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/home_greeting_first"
                    android:textColor="?attr/colorTextLevel1"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_home_card"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/home_greeting_second"
                    android:textColor="?attr/colorTextLevel1"
                    android:textSize="18sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/homeFirstLanguage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/home_you_speak"
                    android:textColor="?attr/colorTextLevel3"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/homeFirstLanguageText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/loading"
                        android:textColor="?attr/colorTextLevel1"
                        android:textSize="17sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dropdown_icon"
                        app:tint="?attr/colorTextLevel1" />
                </LinearLayout>
            </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/homeSwapButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_swap_languages"
                    android:src="@drawable/invert_arrows"
                    app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/homeSecondLanguage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/home_they_speak"
                    android:textColor="?attr/colorTextLevel3"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/homeSecondLanguageText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/loading"
                        android:textColor="?attr/colorTextLevel1"
                        android:textSize="17sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dropdown_icon"
                        app:tint="?attr/colorTextLevel1" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeStartButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="?attr/colorPrimary"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/description_start_walkietalkie"
                android:textAllCaps="false"
                android:textColor="@color/accent_white"
                android:textSize="18sp"
                app:cornerRadius="30dp"
                app:icon="@drawable/mic_icon"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/accent_white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeTypeButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/home_type_instead"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeCallButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/call_mode_button"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/component_bottom_nav" />
</LinearLayout>
